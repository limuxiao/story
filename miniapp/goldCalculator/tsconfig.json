{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "module": "CommonJS",
    "target": "ES5",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "types": ["miniprogram-api-typings"],
    "skipLibCheck": true
  },
  "include": ["app.ts", "pages/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules"]
}
