page {
  --gold: #b8860b;
  --gold-2: #d4a72c;
  --ink: #2b2418;
  --muted: #857963;
  --line: #e9e0cd;
  --pos: #0a8f5b;
  --neg: #cf3c3c;
  --bg: #faf7f0;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.page { min-height: 100vh; }

.header {
  background: linear-gradient(135deg, #2c2416, #4a3a18 55%, #6b521c);
  color: #f6e7c2;
  padding: 60rpx 40rpx 54rpx;
  text-align: center;
}
.badge {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  padding: 6rpx 24rpx;
  border: 1rpx solid rgba(226, 193, 120, .5);
  border-radius: 999rpx;
  color: #e9cd8c;
  margin-bottom: 20rpx;
}
.title { font-size: 44rpx; font-weight: 600; letter-spacing: 2rpx; }
.subtitle { font-size: 24rpx; color: rgba(246, 231, 194, .7); margin-top: 14rpx; }

.wrap { padding: 32rpx 28rpx 0; }

.card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 6rpx 30rpx rgba(90, 70, 30, .05);
}
.card-title { display: flex; align-items: center; margin-bottom: 30rpx; }
.bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(var(--gold-2), var(--gold));
  margin-right: 14rpx;
}
.title-text { font-size: 28rpx; font-weight: 600; color: #6b572c; }
.example {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--gold);
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.5;
}
.example::after { border: none; }

.field { margin-bottom: 26rpx; }
.field:last-child { margin-bottom: 0; }
.field-label {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 26rpx;
  color: #5d5240;
  margin-bottom: 14rpx;
}
.hint { font-size: 22rpx; color: var(--muted); }
.input-box { position: relative; }
.input-box input {
  width: 100%;
  height: 88rpx;
  padding: 0 100rpx 0 26rpx;
  font-size: 32rpx;
  color: var(--ink);
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: #fdfbf6;
  box-sizing: border-box;
}
.ph { color: #b9ad95; }
.suffix {
  position: absolute;
  right: 26rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: var(--muted);
}

.segment {
  display: flex;
  background: #f2ecdd;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}
.segment-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  color: #7a6c51;
}
.segment-item.active {
  background: #fff;
  color: #6b4e08;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(90, 70, 30, .12);
}

.warning { color: var(--neg); font-size: 24rpx; min-height: 34rpx; margin-top: 12rpx; }

.hero {
  background: linear-gradient(135deg, #fffdf7, #fff8e8);
  border: 1rpx solid #ecdcae;
  border-radius: 32rpx;
  padding: 38rpx 34rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 10rpx 36rpx rgba(160, 120, 30, .09);
}
.hero-label { font-size: 24rpx; color: #8a7440; letter-spacing: 2rpx; }
.hero-big { font-size: 72rpx; font-weight: 700; color: #7a5a12; line-height: 1.25; margin: 8rpx 0 4rpx; }
.hero-unit { font-size: 28rpx; font-weight: 500; margin-left: 8rpx; color: #9c8549; }
.hero-sub { font-size: 24rpx; color: #9a8a64; }
.stats {
  display: flex;
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx dashed #e3d3a8;
}
.stat { flex: 1; text-align: center; }
.stat-k { font-size: 22rpx; color: #9a8a64; margin-bottom: 4rpx; }
.stat-v { font-size: 36rpx; font-weight: 600; color: #4a3b1e; }
.mini { font-size: 22rpx; font-weight: 400; color: var(--muted); margin-left: 2rpx; }

.grid { display: flex; flex-wrap: wrap; }
.cell {
  width: calc(50% - 10rpx);
  margin: 0 20rpx 20rpx 0;
  box-sizing: border-box;
  background: #fbf9f4;
  border: 1rpx solid #f0e9d9;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
}
.cell.last { margin-right: 0; }
.cell-k { font-size: 22rpx; color: var(--muted); margin-bottom: 6rpx; }
.cell-v { font-size: 30rpx; font-weight: 600; word-break: break-all; }
.cell-unit { font-size: 22rpx; font-weight: 400; color: var(--muted); margin-left: 4rpx; }

.pos { color: var(--pos) !important; }
.neg { color: var(--neg) !important; }

.note { font-size: 22rpx; color: #9a8d75; line-height: 1.8; padding: 8rpx 12rpx 20rpx; }
