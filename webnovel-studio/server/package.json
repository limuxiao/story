{
  "name": "webnovel-studio-server",
  "version": "1.0.0",
  "private": true,
  "description": "网文写作学习目标管理台 - 后端服务（NestJS + SQLite）",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "dev:build": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "seed": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "better-sqlite3": "^11.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
